#include "ordos/config.h"

OUTPUT_FORMAT(elf32-i386)
OUTPUT_ARCH(i386)
ENTRY(_start)

SECTIONS
{
  . = ORDOS_KERNEL_LADDR;

  __ld_kernel_start_paddr = .;
  __ld_kernel_start_vaddr = . + ORDOS_KERNEL_VADDR;

  .text.init : {
    *(.text.init)
  }

  .rodata.init : {
    *(.rodata.init)
  }

  .data.init : {
    *(.data.init)
  }

  .bss.init : {
    *(.bss.init)
  }

  . += ORDOS_KERNEL_VADDR;

  .text : AT(ADDR(.text) - ORDOS_KERNEL_VADDR) {
    *(.text)
  }

  .rodata : AT(ADDR(.rodata) - ORDOS_KERNEL_VADDR) {
    *(.rodata)
  }

  .data.module ALIGN(1) : AT(ADDR(.data.module) - ORDOS_KERNEL_VADDR) SUBALIGN(1) {
    __ld_kernel_modules_start_vaddr = .;
    *(.data.module)
    __ld_kernel_modules_end_vaddr = .;
  }

  .data : AT(ADDR(.data) - ORDOS_KERNEL_VADDR) {
    *(.data)
  }

  .bss : AT(ADDR(.bss) - ORDOS_KERNEL_VADDR) {
    *(.bss)
  }

  __ld_kernel_end_vaddr = .;
  __ld_kernel_end_paddr = . - ORDOS_KERNEL_VADDR;

  /DISCARD/ : {
    *(.note*)
  }
}
